{
  "name": "coursive-source-fudan",
  "version": "0.1.1",
  "license": "MIT",
  "private": true,
  "coursive": {
    "id": "fudan",
    "title": "复旦大学",
    "summary": "用复旦 UIS 登录，通过 WebVPN 读取 iCourse 录播课程和 Canvas 作业",
    "icon": "icon.svg",
    "api": "^3.0.0",
    "runtime": [{
      "kind": "process",
      "entry": {
        "linux-x64": "bin/provider-linux-x64",
        "linux-arm64": "bin/provider-linux-arm64",
        "windows-x64": "bin/provider-windows-x64.exe",
        "macos-arm64": "bin/provider-macos-arm64",
        "macos-x64": "bin/provider-macos-x64"
      }
    }],
    "permissions": ["source"],
    "contributes": {
      "sources": [{
        "id": "fudan",
        "title": "复旦大学",
        "protocol": "1",
        "executable": {
          "linux-x64": "bin/provider-linux-x64",
          "linux-arm64": "bin/provider-linux-arm64",
          "windows-x64": "bin/provider-windows-x64.exe",
          "macos-arm64": "bin/provider-macos-arm64",
          "macos-x64": "bin/provider-macos-x64"
        },
        "hosts": ["id.fudan.edu.cn", "webvpn.fudan.edu.cn", "icourse.fudan.edu.cn", "elearning.fudan.edu.cn"]
      }]
    }
  }
}

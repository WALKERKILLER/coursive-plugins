{
  "name": "coursive-source-tongji",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "coursive": {
    "id": "tongji",
    "title": "同济大学",
    "summary": "用同济统一身份认证登录，读取录播课程和 Canvas 作业",
    "icon": "icon.svg",
    "categories": ["source"],
    "engine": "^2.0.0",
    "permissions": ["source"],
    "contributes": {
      "sources": [{
        "id": "tongji",
        "title": "同济大学",
        "protocol": "1",
        "executable": {
          "linux-x64": "bin/provider-linux-x64",
          "linux-arm64": "bin/provider-linux-arm64",
          "windows-x64": "bin/provider-windows-x64.exe",
          "macos-arm64": "bin/provider-macos-arm64",
          "macos-x64": "bin/provider-macos-x64"
        },
        "hosts": ["look.tongji.edu.cn", "iam.tongji.edu.cn", "canvas.tongji.edu.cn"]
      }]
    }
  }
}

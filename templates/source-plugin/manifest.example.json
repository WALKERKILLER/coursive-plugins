{
  "name": "coursive-source-example",
  "version": "0.1.0",
  "license": "MIT",
  "coursive": {
    "id": "example-source",
    "title": "Example Lectures",
    "summary": "Sign in to Example Lectures and download your recorded courses",
    "icon": "cloud_download",
    "api": "^3.0.0",
    "runtime": [{
      "kind": "process",
      "entry": {
        "linux-x64": "bin/provider-linux-x64",
        "linux-arm64": "bin/provider-linux-arm64",
        "windows-x64": "bin/provider-windows-x64.exe",
        "macos-arm64": "bin/provider-macos-arm64",
        "macos-x64": "bin/provider-macos-x64"
      }
    }],
    "permissions": ["source"],
    "contributes": {
      "sources": [{
        "id": "example",
        "title": "Example Lectures",
        "protocol": "1",
        "executable": {
          "linux-x64": "bin/provider-linux-x64",
          "linux-arm64": "bin/provider-linux-arm64",
          "windows-x64": "bin/provider-windows-x64.exe",
          "macos-arm64": "bin/provider-macos-arm64",
          "macos-x64": "bin/provider-macos-x64"
        },
        "hosts": ["lectures.example.org"]
      }]
    }
  }
}
